# ─── ResearchGPT configuration ────────────────────────────────────────────────
# Copy to .env and adjust. Defaults below target a local Ollama + mistral:7b setup.
# Every value here is optional — config/config.py has a sane default for each.

# ─── LLM provider ─────────────────────────────────────────────────────────────
# "ollama" = fully local, no API key needed.  "openai" = remote OpenAI-compatible API.
RAG_LLM_PROVIDER=ollama

# ─── Ollama (local) ───────────────────────────────────────────────────────────
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=mistral:7b

# Context window the model is loaded with.
# Ollama's own default is only 4096 tokens, which silently truncates the long
# RAG prompts this pipeline builds — the model would then answer from a fraction
# of the retrieved papers. Mistral 7B supports up to 32768.
# Lower this to 8192 if you are short on RAM/VRAM.
RAG_OLLAMA_NUM_CTX=16384

# Keep the model loaded between calls (a paper needs many calls; reloading
# 4.4 GB each time is the single biggest avoidable cost).
RAG_OLLAMA_KEEP_ALIVE=30m

# Per-request timeout in seconds. A 7B model on CPU can take several minutes.
RAG_OLLAMA_TIMEOUT=900

# ─── Generation limits ────────────────────────────────────────────────────────
# Max tokens generated per call. Keep NUM_CTX > LLM_MAX_TOKENS + prompt size.
RAG_LLM_MAX_TOKENS=4096
RAG_LLM_TEMPERATURE=0.2
# Characters of each retrieved chunk passed to the model.
RAG_MAX_CONTEXT_TOKENS=2000

# ─── Remote provider (only used when RAG_LLM_PROVIDER=openai) ─────────────────
# CEREBRAS_API_KEY=
# RAG_OPENAI_BASE_URL=https://api.cerebras.ai/v1
# RAG_OPENAI_MODEL=gpt-oss-120b

# ─── API server ───────────────────────────────────────────────────────────────
RAG_API_HOST=127.0.0.1
RAG_API_PORT=8001
RAG_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# ─── Retrieval / pipeline ─────────────────────────────────────────────────────
RAG_TOP_K=5
RAG_MAX_PAPERS=5
RAG_SURVEY_DEFAULT_PAPERS=10
RAG_EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RAG_CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# ─── Logging ──────────────────────────────────────────────────────────────────
RAG_LOG_LEVEL=INFO
